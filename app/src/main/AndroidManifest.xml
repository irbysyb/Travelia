<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin Akses Internet & Cek Koneksi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Izin Notifikasi (Wajib untuk Android 13 / API 33 ke atas) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Izin Penjadwalan Alarm Presisi (Untuk Notifikasi Pengingat -2 Jam) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Travelia">

        <!-- Activity Utama (Launcher / Screen Pertama) -->
        <activity
            android:name=".StartAppActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity Panel Admin -->
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity Pemesanan & Tiket -->
        <activity
            android:name=".PesanTiketActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".TiketSayaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Activity Autentikasi & Navigasi Utama -->
        <activity
            android:name=".OptionToEnterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OtpActivity"
            android:exported="false" />

        <activity
            android:name=".CreateUsernameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".UserDataActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LoadingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".JadwalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".RiwayatPesananActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfilActivity"
            android:exported="false" />

    </application>

</manifest>