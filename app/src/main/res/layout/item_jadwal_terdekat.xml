<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Baris Atas: Rute & Jam Keberangkatan (Biru) -->
    <TextView
        android:id="@+id/tvRute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Medan - Lhokseumawe"
        android:textColor="#111111"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvJam"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvJam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15:00"
        android:textColor="#3B82F6"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Baris Kedua: Tanggal & Sisa Kursi (Hijau) -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:text="30 Oktober 2026"
        android:textColor="#4B5563"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@+id/tvSisaKursi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRute" />

    <TextView
        android:id="@+id/tvSisaKursi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sisa Kursi: 5"
        android:textColor="#059669"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tvDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvDate" />

    <!-- Baris Ketiga: Subtitle / Keterangan Armada -->
    <TextView
        android:id="@+id/tvArmada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Travelia Express • Toyota Hiace Premio"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDate" />

    <!-- Divider Tipis -->
    <View
        android:id="@+id/dividerItem"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#F3F4F6"
        app:layout_constraintTop_toBottomOf="@+id/tvArmada" />

    <!-- Baris Bawah: Harga (Oranye) & Tombol Pesan Tiket (Biru) -->
    <TextView
        android:id="@+id/tvHarga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 170.000"
        android:textColor="#F97316"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnPesanSekarang"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnPesanSekarang" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPesanSekarang"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#FF7A22"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Pesan Sekarang"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerItem" />

</androidx.constraintlayout.widget.ConstraintLayout>