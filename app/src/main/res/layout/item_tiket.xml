<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Baris 1: Rute Kota & Jam Berangkat -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvWaktu"
                android:layout_marginEnd="8dp"
                android:text="Medan - Bireuen"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWaktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="20:00"
                android:textColor="#3D5CFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Baris 2: Tanggal Keberangkatan & Sisa Kursi -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24/10/2026"
                android:textColor="#444444"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSisaKursi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Sisa Kursi: 2"
                android:textColor="#00A86B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Baris 3: Informasi Armada Bus (Disusun ke Bawah / Vertikal) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <!-- TextView untuk Nama Armada (Baris Atas) -->
            <TextView
                android:id="@+id/tvNamaArmada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Travelia Express"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- TextView untuk Tipe Armada (Baris Bawah) -->
            <TextView
                android:id="@+id/tvTipeArmada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Toyota Hiace Premio"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Garis Pemisah Tipis -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#F0F0F0" />

        <!-- Baris 4: Harga Format Rp 180.000 & Tombol Pesan -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvHarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Rp 180.000"
                android:textColor="#FF7A22"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPesan"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:backgroundTint="#5B86E5"
                android:paddingHorizontal="16dp"
                android:text="Pesan Tiket"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>