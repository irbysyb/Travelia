<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="0dp">

    <!-- Thumbnail Gambar dari Firestore (menggunakan tools:src agar tidak menimpa Glide) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgArticleThumb"
        android:layout_width="100dp"
        android:layout_height="85dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/img_article_hiace"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.RoundedSquare" />

    <!-- Teks Judul & Deskripsi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvArticleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Judul Artikel Travel" />

        <TextView
            android:id="@+id/tvArticleDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#666666"
            android:textSize="11sp"
            tools:text="Ringkasan singkat artikel seputar dunia travel..." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="Baca Selengkapnya ➔"
            android:textColor="#0066CC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>