<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Garis Indikator Atas -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D0D0D0" />

    <!-- Judul Header -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Konfirmasi Pembayaran"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Baris Rute & ID Tiket (Sejajar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSheetRute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lhokseumawe ➔ Medan"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: TRV-882103"
            android:textColor="#888888"
            android:textSize="12sp"
            tools:text="ID: TRV-882103" />
    </LinearLayout>

    <!-- Tanggal Keberangkatan (Dipisah) -->
    <TextView
        android:id="@+id/tvSheetTanggal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tanggal: 23/10/2026"
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- Jam Keberangkatan (Dipisah) -->
    <TextView
        android:id="@+id/tvSheetWaktu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Jam: 09:00"
        android:textColor="#555555"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#E0E0E0" />

    <!-- Tampilan QR Code -->
    <ImageView
        android:id="@+id/imgQrCode"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_camera"
        tools:ignore="ContentDescription" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Scan QR Code ini di loket pembayaran untuk melunasi tiket."
        android:textColor="#777777"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Total Tagihan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total Pembayaran"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetTotalHarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 360.000"
            android:textColor="#FF7A1A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tombol Konfirmasi Pembayaran Lunas -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBayarSekarang"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="Konfirmasi Pembayaran Lunas"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#008855"
        app:cornerRadius="14dp" />

</LinearLayout>