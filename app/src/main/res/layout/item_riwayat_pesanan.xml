<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EAEAEA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: CheckBox, Armada, Tanggal, ID Tiket & Nama Penumpang -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/cbSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/cbSelect"
                android:orientation="vertical">

                <!-- Baris 1: Tipe Armada & Tanggal Keberangkatan -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvBusType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/tvDepartureDate"
                        android:text="Toyota Hiace Premio"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDepartureDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="30 Oktober 2026"
                        android:textColor="#4B5563"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Baris 2: ID Pesanan (Terpisah) -->
                <TextView
                    android:id="@+id/tvIdPesanan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ID: TRV-982341"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <!-- Baris 3: Nama Penumpang (Terpisah) -->
                <TextView
                    android:id="@+id/tvNamaPenumpang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Budi Santoso"
                    android:textColor="#374151"
                    android:textSize="12sp"/>

            </LinearLayout>
        </RelativeLayout>

        <!-- Container Alur Perjalanan (Presisi) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <!-- Jam Keberangkatan (Di Tengah Garis Vertikal) -->
            <TextView
                android:id="@+id/tvDepartureTime"
                android:layout_width="50dp"
                android:layout_height="0dp"
                android:layout_alignParentStart="true"
                android:layout_alignTop="@id/rowAsal"
                android:layout_alignBottom="@id/rowTujuan"
                android:gravity="center_vertical|end"
                android:text="08:00"
                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Garis Vertikal Tengah -->
            <View
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_alignTop="@id/rowAsal"
                android:layout_alignBottom="@id/rowTujuan"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_toEndOf="@id/tvDepartureTime"
                android:background="#E5E7EB" />

            <!-- Baris 1: Bulatan Atas & Kota Asal -->
            <LinearLayout
                android:id="@+id/rowAsal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tvDepartureTime"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/bg_dot_blue" />

                <TextView
                    android:id="@+id/tvAsal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Lhokseumawe"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Baris 2: Bulatan Bawah & Kota Tujuan -->
            <LinearLayout
                android:id="@+id/rowTujuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rowAsal"
                android:layout_marginTop="22dp"
                android:layout_toEndOf="@id/tvDepartureTime"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/bg_dot_outline" />

                <TextView
                    android:id="@+id/tvTujuan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Medan"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="DuplicateSpeakableTextCheck" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Garis Pemisah / Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#F3F4F6" />

        <!-- Footer: Total Harga & Label Status Tiket (Aktif / Tidak Aktif) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvTotalBayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Rp 200,000 (2 Kursi)"
                android:textColor="#FF7A1A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Badge Status Tiket di Pojok Kanan Bawah -->
            <TextView
                android:id="@+id/tvStatusTiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_active"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Aktif"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Aktif" />

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>