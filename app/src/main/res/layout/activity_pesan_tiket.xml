<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"
    tools:context=".PesanTiketActivity">

    <!-- Header Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesan Tiket"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scroll Content Form + Hasil -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@+id/headerCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Form Input -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Dari Dropdown -->
                    <TextView
                        android:id="@+id/lblDari"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dari"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDari"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundColor="#F9F9F9"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#DDDDDD"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/lblDari"
                        app:startIconDrawable="@drawable/ic_bus">

                        <AutoCompleteTextView
                            android:id="@+id/etDari"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Masukkan Kota asal"
                            android:inputType="none"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ke Dropdown -->
                    <TextView
                        android:id="@+id/lblKe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Ke"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tilDari" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilKe"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundColor="#F9F9F9"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#DDDDDD"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/lblKe"
                        app:startIconDrawable="@drawable/ic_bus">

                        <AutoCompleteTextView
                            android:id="@+id/etKe"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Masukkan Kota tujuan"
                            android:inputType="none"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Button Swap -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnSwap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Swap"
                        android:src="@drawable/ic_swap"
                        app:backgroundTint="#5B8FF9"
                        app:fabCustomSize="40dp"
                        app:layout_constraintBottom_toTopOf="@+id/tilKe"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tilDari"
                        app:tint="#FFFFFF" />

                    <!-- Tanggal Berangkat -->
                    <TextView
                        android:id="@+id/lblTanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tanggal Berangkat"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tilKe" />

                    <EditText
                        android:id="@+id/etTanggal"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rounded_input"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:drawablePadding="12dp"
                        android:focusable="false"
                        android:hint="Masukkan tanggal keberangkatan"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@+id/lblTanggal" />

                    <!-- ROW WAKTU & JUMLAH KURSI (2 KOLOM) -->
                    <TextView
                        android:id="@+id/lblWaktu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="Waktu"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/lblJumlahKursi"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/etTanggal" />

                    <TextView
                        android:id="@+id/lblJumlahKursi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Jumlah Kursi"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/lblWaktu"
                        app:layout_constraintTop_toTopOf="@+id/lblWaktu" />

                    <!-- Dropdown Waktu Spesifik -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWaktu"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        app:boxBackgroundColor="#F9F9F9"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#DDDDDD"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false"
                        app:layout_constraintEnd_toStartOf="@+id/etJumlahKursi"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblWaktu"
                        app:startIconDrawable="@drawable/ic_clock">

                        <AutoCompleteTextView
                            android:id="@+id/etWaktu"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Jam"
                            android:inputType="none"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <EditText
                        android:id="@+id/etJumlahKursi"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rounded_input"
                        android:drawableStart="@drawable/ic_seat"
                        android:drawablePadding="10dp"
                        android:hint="1 Kursi"
                        android:inputType="number"
                        android:maxLength="2"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tilWaktu"
                        app:layout_constraintTop_toBottomOf="@+id/lblJumlahKursi" />

                    <!-- Kriteria Algoritma Greedy (Dropdown) -->
                    <TextView
                        android:id="@+id/lblKriteria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Kriteria Tiket (Algoritma Greedy)"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tilWaktu" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilKriteria"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundColor="#F9F9F9"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#DDDDDD"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/lblKriteria">

                        <AutoCompleteTextView
                            android:id="@+id/etKriteria"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Pilih Kriteria Tiket"
                            android:inputType="none"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Container Tombol -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/tilKriteria">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCari"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#5B8FF9"
                            android:text="Cari"
                            android:textAllCaps="false"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRekomendasi"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FF7A22"
                            android:text="Rekomendasi"
                            android:textAllCaps="false"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION HASIL PENCARIAN TIKET -->
            <TextView
                android:id="@+id/tvTitleHasil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Hasil Pencarian Tiket"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTiket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_tiket" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>